#
#
# ~chewygumxx/zsh-config.git
# ::: :/.npmrc
#
#

# Turns the "engines" block in package.json into a hard requirement rather than
# a warning. Without it, an npm older than 12 installs happily and ignores
# patchedDependencies in silence, leaving the patch under patches/ unapplied
# with no indication anything was skipped.
engine-strict=true
