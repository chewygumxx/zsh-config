{
    "name": "zsh-config",
    "description": "My Zsh shell configuration dotfiles",
    "private": true,
    "keywords": [
        "dotfiles",
        "zsh-config",
        "config"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/zsh-config",
    "repository": "github:chewygumxx/zsh-config",
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@chewygumxx/commitlint-config": "^1.0.2",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.1",
        "@commitlint/cli": "^21.2.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.7",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "commit": "cz",
        "prepare": "test -d node_modules/husky && husky || true",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    },
    "prettier": {
        "overrides": [
            {
                "files": "*.jsonc",
                "options": {
                    "trailingComma": "none"
                }
            },
            {
                "files": ".zunit.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
