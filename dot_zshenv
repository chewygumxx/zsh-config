#
# Universal Zsh Initialisation
#

typeset -ga zshenvs
zshenvs=(
    "$XDG_CONFIG_HOME/zsh/env/"*.env.zsh
)

() {
    local source
    for source in $zshenvs; do
        source "$source"
    done
}
