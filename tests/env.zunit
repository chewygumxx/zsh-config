#!/usr/bin/env zunit
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/zsh-config.git
# ::: :/tests/env.zunit
#
#

#
# Regressions in what .zshenv and env/ set up.
#
# Every test here starts a non-interactive shell only, which never reaches
# rc/plugin.rc.zsh or rc/completion.rc.zsh and so never clones anything. That
# is why this file needs no borrowed plugin clones and, unlike boot.zunit,
# always runs.
#

@setup {
    load _support/sandbox

    SANDBOX="$(sandbox_create)"
    sandbox_warm "$SANDBOX"
}

@teardown {
    sandbox_destroy "$SANDBOX"
}

@test 'A deleted cache tree is recreated on the next start' {
    # A stamp file outside the tree once stood in for checking the tree itself,
    # so deleting the tree left the stamp behind and nothing was recreated.
    command rm -rf -- "$SANDBOX/.local/cache/zsh"

    sandbox_zsh "$SANDBOX" -c exit > /dev/null 2>&1

    assert "$SANDBOX/.local/cache/zsh/completions" is_dir
    assert "$SANDBOX/.local/cache/zsh/init" is_dir
}

@test 'A forwarded agent socket survives an ssh login' {
    local -a SANDBOX_ENV=(
        SSH_CONNECTION='192.0.2.1 50000 192.0.2.2 22'
        SSH_AUTH_SOCK=/tmp/ssh-forwarded/agent.1
    )

    run sandbox_zsh_stdout "$SANDBOX" -c 'print -r -- $SSH_AUTH_SOCK'

    assert "$output" same_as /tmp/ssh-forwarded/agent.1
}

@test 'A local shell uses the Proton Pass agent socket' {
    run sandbox_zsh_stdout "$SANDBOX" -c 'print -r -- $SSH_AUTH_SOCK'

    assert "$output" same_as "$SANDBOX/run/ssh-agent-protonpass.socket"
}

@test 'A nested shell does not grow PATH' {
    run sandbox_zsh_stdout "$SANDBOX" -c \
        'print -r -- $#path; zsh -c "print -r -- \$#path"'

    local -a counts=("${(@f)output}")

    assert ${#counts} equals 2
    assert "$counts[2]" equals "$counts[1]"
}

@test 'A non-interactive shell carries the tool relocations' {
    run sandbox_zsh_stdout "$SANDBOX" -c \
        'print -r -- "$GNUPGHOME"; print -r -- "$CARGO_HOME"'

    local -a lines=("${(@f)output}")

    assert "$lines[1]" same_as "$SANDBOX/.local/share/gnupg"
    assert "$lines[2]" same_as "$SANDBOX/.local/share/cargo"
}

@test 'No path collapses to the root when XDG variables are unset' {
    run sandbox_zsh_bare "$SANDBOX" -c '
        print -rl -- $path "$SSH_AUTH_SOCK" "$GNUPGHOME" "$CARGO_HOME" \
            ${(v)zsh_dirs}
    ' 2> /dev/null

    local -a values=("${(@f)output}")
    local -a rooted=(${(M)values:#/(cargo|go|gnupg|ssh-agent|zsh)*})

    assert ${#rooted} equals 0
    assert "$output" contains "$SANDBOX/.local/share/gnupg"
}
