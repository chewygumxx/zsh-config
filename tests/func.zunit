#!/usr/bin/env zunit
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/zsh-config.git
# ::: :/tests/func.zunit
#
#

#
# Unit tests for the autoloaded functions in func/.
#
# These files cannot be sourced: each is an autoload body with no
# `function name { ... }` wrapper, so tests/_support/autoload.zsh puts func/ and
# wrap/ on fpath and marks the name for autoload instead, which is what
# rc/function.rc.zsh does for an interactive shell.
#

@setup {
    load _support/autoload

    TMP="$(mktemp -d -- "${TMPDIR:-/tmp}/zsh-config-unit.XXXXXXXX")"
}

@teardown {
    if [[ -n "$TMP" && -d "$TMP" ]]; then
        command rm -rf -- "$TMP"
    fi
}

@test '__slugify lowercases and replaces anything unreserved' {
    load_shell_function __slugify

    run __slugify 'Hello World! 2024'

    assert "$output" same_as hello_world_2024
}

@test '__slugify keeps dot, hyphen and underscore by default' {
    load_shell_function __slugify

    run __slugify 'a.b-c_d'

    assert "$output" same_as 'a.b-c_d'
}

@test '__slugify -D drops the dot from the allowed set' {
    load_shell_function __slugify

    run __slugify -D 'a.b-c_d'

    assert "$output" same_as 'a_b-c_d'
}

@test '__slugify -H drops the hyphen from the allowed set' {
    load_shell_function __slugify

    run __slugify -H 'a.b-c_d'

    assert "$output" same_as 'a.b_c_d'
}

@test '__slugify -U cannot remove an underscore' {
    # Pins a quirk rather than a feature. -U takes the underscore out of the
    # allowed set, but the character every disallowed run is replaced with is
    # itself an underscore, so an underscore in the input survives regardless
    # and the flag has no visible effect on it.
    load_shell_function __slugify

    run __slugify -U 'a.b-c_d'

    assert "$output" same_as 'a.b-c_d'
}

@test '__slugify collapses runs and trims the ends' {
    load_shell_function __slugify

    run __slugify '___lead   and   trail___'

    assert "$output" same_as lead_and_trail
}

@test 'mkcd reports usage and returns 2 with no argument' {
    # Called with no argument this once ran `mkdir -p ""`, which errors, then
    # `cd ""`, which silently succeeds as a no-op, leaving the caller where it
    # started with no indication of what had gone wrong.
    load_shell_function mkcd

    run mkcd

    assert $state equals 2
    assert "$output" contains 'Usage'
}

@test 'mkcd creates a nested path and changes into it' {
    load_shell_function mkcd

    # Run through a command substitution so the directory change stays in the
    # subshell rather than moving the shell running this suite.
    local result
    result="$(cd -- "$TMP" && mkcd deep/nested > /dev/null && print -r -- "$PWD")"

    assert "$result" same_as "${TMP:A}/deep/nested"
    assert "$TMP/deep/nested" is_dir
}

@test 'mkdirt creates every argument with a .keep inside' {
    load_shell_function mkdirt

    ( cd -- "$TMP" && mkdirt one two/three )

    assert "$TMP/one/.keep" is_file
    assert "$TMP/two/three/.keep" is_file
}

@test 'openrouter never puts the API key in an argument' {
    stub_command pass-cli "$TMP/bin" 'printf "%s\n" sekrit'
    stub_command curl "$TMP/bin" \
        'for a; do case "$a" in' \
        '    @*) printf "file:%s\n" "$(cat "${a#@}")" ;;' \
        '    *) printf "arg:%s\n" "$a" ;;' \
        'esac; done'
    load_shell_function openrouter

    local PASS_URI_OPENROUTER_APIKEY='pass://vault/item/field'
    run openrouter '{}'

    assert $state equals 0
    assert "$output" contains 'file:Authorization: Bearer sekrit'
    assert "$output" does_not_contain 'arg:Authorization'
}

@test 'openrouter stops when the API key cannot be read' {
    stub_command pass-cli "$TMP/bin" 'exit 1'
    stub_command curl "$TMP/bin"
    load_shell_function openrouter

    local PASS_URI_OPENROUTER_APIKEY='pass://vault/item/field'
    run openrouter '{}'

    assert $state equals 1
    assert "$output" does_not_contain 'stub:'
}

#
# __plugin_clone calls zsh_dirs_require, which env/zsh_dirs.env.zsh defines.
# That file cannot be sourced here without creating directories under the real
# XDG tree, so a stand-in accepting every key is defined for these tests alone.
#

@test '__plugin_clone repairs an interrupted clone' {
    stub_command git "$TMP/bin" \
        'for a; do dest="$a"; done' \
        'mkdir -p "$dest" && : > "$dest/demo.plugin.zsh"'
    load_shell_function __plugin_clone
    function zsh_dirs_require() { return 0 }

    local -A zsh_dirs=([plugin]="$TMP/plugins")

    # What an interrupted clone leaves: the directory, but no entry point.
    mkdir -p -- "$TMP/plugins/demo/.git"

    run __plugin_clone owner/demo

    unfunction zsh_dirs_require

    assert $state equals 0
    assert "$TMP/plugins/demo/demo.plugin.zsh" is_file
}

@test '__plugin_clone leaves the old directory when a clone fails' {
    stub_command git "$TMP/bin" 'exit 128'
    load_shell_function __plugin_clone
    function zsh_dirs_require() { return 0 }

    local -A zsh_dirs=([plugin]="$TMP/plugins")
    mkdir -p -- "$TMP/plugins/demo/.git"

    run __plugin_clone owner/demo

    unfunction zsh_dirs_require

    local -a staging=("$TMP"/plugins/demo.clone.*(N))

    assert $state equals 1
    assert "$output" contains 'Failed to clone plugin: owner/demo'
    assert "$TMP/plugins/demo/.git" is_dir
    assert ${#staging} equals 0
}

@test '__plugin_clone rejects a malformed slug' {
    load_shell_function __plugin_clone

    run __plugin_clone owner/

    assert $state equals 1
    assert "$output" contains 'Not an owner/repo slug'
}

@test '__slugify collapses runs without the caller setting extended_glob' {
    setopt local_options no_extended_glob
    load_shell_function __slugify

    run __slugify 'a   b'

    assert "$output" same_as a_b
}

@test 'gc joins its message words with spaces whatever IFS holds' {
    stub_command git "$TMP/bin"
    load_shell_function gc

    local IFS=:
    local result
    result="$(gc two words 2> /dev/null)"

    assert "$result" contains '--message=two words'
}
