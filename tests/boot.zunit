#!/usr/bin/env zunit
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/zsh-config.git
# ::: :/tests/boot.zunit
#
#

#
# Startup regressions: the assertions the "Verifying changes" section of
# CLAUDE.md sets out in prose, made executable.
#
# Each runs against a throwaway HOME. A plain `zsh -ic` on this machine loads
# the live ~/.config/zsh rather than this checkout, so it proves nothing at all
# about a change made here.
#
# The shebang above is required by zunit and has to be the very first line: it
# reads only line one when deciding whether a file is a test file. Everything
# below it follows the usual header convention.
#

@setup {
    load _support/sandbox

    # Guarded for the whole file, not test by test. Every assertion below starts
    # a full interactive shell, and a full start makes rc/plugin.rc.zsh and
    # rc/completion.rc.zsh clone anything missing, so without a cache of clones
    # to borrow the entire suite would reach the network rather than only the
    # handful of tests that mention a plugin by name.
    #
    # Skipping loudly is the point. The alternative is a suite that appears to
    # pass while testing whatever GitHub served that minute.
    sandbox_plugin_source > /dev/null ||
        skip 'No plugin clones to borrow. Set ZSH_TEST_PLUGIN_DIR to a
            directory of them, or run once with a populated
            $XDG_DATA_HOME/zsh/plugins'

    SANDBOX="$(sandbox_create)"
    sandbox_warm "$SANDBOX"
}

@teardown {
    sandbox_destroy "$SANDBOX"
}

@test 'An interactive shell starts with nothing on stderr' {
    run sandbox_zsh_stderr "$SANDBOX" -i -c exit

    assert "$output" is_empty
}

@test 'An insecure fpath entry does not abort completion' {
    # Regression test for a real failure this suite found on CI, where one
    # world-writable directory on the default system fpath was enough.
    #
    # Without `compinit -i`, compaudit sends compinit to a prompt, a shell with
    # no terminal cannot answer, and it prints `not interactive and can't open
    # terminal` then `compinit: initialization aborted` and gives up entirely.
    # The shell is then left with no completion at all.
    #
    # share_comp is the vehicle because rc/completion.rc.zsh puts it on fpath
    # directly. Group-writable is not enough to trigger this; it has to be
    # writable by others.
    #
    # A sandbox of its own, left cold on purpose. compinit -C skips the audit
    # altogether, so once a valid dump exists the check never runs again and the
    # fault cannot reproduce. It needs an empty cache, which is the state CI is
    # always in, and is why the shared warmed fixture is no use here.
    local root
    root="$(sandbox_create)"

    mkdir -p -m 0777 -- "$root/.local/share/zsh/completions"
    chmod 0777 -- "$root/.local/share/zsh/completions"

    local diagnostics initialised
    diagnostics="$(sandbox_zsh_stderr "$root" -i -c exit)"
    initialised="$(sandbox_zsh_stdout "$root" -i -c \
        'print -r -- $(( $+functions[_main_complete] ))')"

    sandbox_destroy "$root"

    # A cold start legitimately announces the caches it is creating, so only
    # compinit's own diagnostics matter here.
    assert "$diagnostics" does_not_contain compinit

    # Completion has to be genuinely initialised, not merely quiet about failing.
    assert "$initialised" equals 1
}

@test 'A non-interactive shell writes no byte to stdout' {
    # Counted in bytes rather than compared as a string. A lone newline
    # corrupts the stream that scp, rsync, sftp and git over ssh read as
    # protocol data just as surely as a sentence does, and a command
    # substitution would strip that newline before any assertion saw it.
    local -i bytes
    bytes=$(sandbox_zsh_stdout "$SANDBOX" -c exit | wc -c)

    assert $bytes equals 0
}

@test 'No element of fpath is empty' {
    # An empty entry on fpath makes zsh autoload out of the current working
    # directory. Counted as "${#${(@M)fpath:#}}", and every part of that is
    # needed: zsh drops empty elements from an unquoted array expansion, and
    # inside double quotes without (@) the filtered array is joined into one
    # word first, so either way the empty match vanished before it was counted
    # and this test could never fail.
    run sandbox_zsh_stdout "$SANDBOX" -i -c 'print -r -- "${#${(@M)fpath:#}}"'

    assert "$output" equals 0
}

@test 'zsh_dirs is an associative array' {
    # same_as, never equals. zunit's `equals` compares with [[ -eq ]], which is
    # arithmetic: zsh evaluates each side as a math expression, bare words
    # become parameters, and two unset parameters are both zero. So
    # `assert association equals banana` passes. Every string comparison in
    # this suite uses same_as for that reason.
    run sandbox_zsh_stdout "$SANDBOX" -i -c 'print -r -- ${(t)zsh_dirs}'

    assert "$output" same_as association
}

@test 'zsh_dirs carries every documented key' {
    # Spelled out rather than counted, so adding a key is a deliberate edit
    # here and not a number that quietly drifts.
    local expected="cache cache_comp cache_init cache_zstylecomp cache_zvm"
    expected+=" comp conf env func plugin rc share share_comp share_func spec"
    expected+=" state util wrap"

    run sandbox_zsh_stdout "$SANDBOX" -i -c 'print -r -- ${(ko)zsh_dirs}'

    assert "$output" same_as "$expected"
}

@test 'Every zsh_dirs value is an existing directory' {
    # Reading an undefined key yields an empty string in silence, which is how
    # an empty entry once reached fpath in the first place.
    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        for key value in "${(kv)zsh_dirs[@]}"; do
            [[ -d "$value" ]] || print -r -- "$key=$value"
        done
    '

    assert "$output" is_empty
}

@test 'Source keys follow ZDOTDIR and state keys do not' {
    # The split env/zsh_dirs.env.zsh exists to maintain: a checkout sourced
    # from anywhere loads its own files, while cache, data and state stay
    # per-user rather than becoming part of the checkout.
    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        for key in conf env comp func wrap rc util spec; do
            [[ "$zsh_dirs[$key]" == "$ZDOTDIR"* ]] ||
                print -r -- "expected under ZDOTDIR: $key"
        done

        for key in cache share plugin state; do
            [[ "$zsh_dirs[$key]" == "$ZDOTDIR"* ]] &&
                print -r -- "expected outside ZDOTDIR: $key"
        done

        true
    '

    assert "$output" is_empty
}

#
# zsh_dirs_require lives in env/zsh_dirs.env.zsh beside the array it validates,
# so it cannot be autoloaded the way func/ and wrap/ can. It is exercised here
# rather than in func.zunit because .zshenv defines it for a non-interactive
# shell too, which makes the sandbox above the cheapest way to reach it.
#

@test 'zsh_dirs_require accepts keys that exist' {
    run sandbox_zsh "$SANDBOX" -c 'zsh_dirs_require probe rc util'

    assert $state equals 0
    assert "$output" is_empty
}

@test 'zsh_dirs_require reports a key that is not set' {
    # Reading an undefined key yields an empty string in silence, which is the
    # failure this validator exists to make loud.
    run sandbox_zsh "$SANDBOX" -c 'zsh_dirs_require probe nosuchkey'

    assert $state equals 1
    assert "$output" contains '[ERROR]'
    assert "$output" contains nosuchkey
}

@test 'zsh_dirs_require reports a key that is not a directory' {
    run sandbox_zsh "$SANDBOX" -c \
        'zsh_dirs[rc]=/nonexistent; zsh_dirs_require probe rc'

    assert $state equals 1
    assert "$output" contains 'is not a directory'
}

@test 'zsh_dirs_require reports an unset zsh_dirs as critical' {
    run sandbox_zsh "$SANDBOX" -c 'unset zsh_dirs; zsh_dirs_require probe rc'

    assert $state equals 1
    assert "$output" contains '[CRITICAL]'
}

@test 'Every enabled spec is loaded' {
    # Derived from spec/ itself, so a new spec is covered the moment it lands.
    # This used to check three function names written out by hand, which a
    # fourth plugin would never have been added to.
    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        local spec
        local -a expected=()
        for spec in $zsh_dirs[spec]/*(N.); do
            () {
                local slug enabled
                source "$spec"
                [[ "$enabled" == false ]] || expected+=("$slug")
            }
        done
        print -r -- "${(j: :)${(@o)expected}}"
        print -r -- "${(j: :)${(@o)zsh_plugins_loaded}}"
    '

    local -a lines=("${(@f)output}")

    assert ${#lines} equals 2
    assert "$lines[1]" is_not_empty
    assert "$lines[2]" same_as "$lines[1]"
}

@test 'Starting the shell clones nothing over the network' {
    # sandbox_create links each borrowed clone in individually, so every entry
    # under the sandbox plugin directory should still be a symlink afterwards. A
    # real directory there means something cloned during startup, which is the
    # failure this guards: a suite that reaches the network tests whatever
    # GitHub served that minute rather than this checkout.
    local -a cloned=("$SANDBOX"/.local/share/zsh/plugins/*(N/^@))

    if (( ${#cloned} )); then
        fail "Cloned during startup: ${(j:, :)${cloned[@]:t}}"
    fi

    assert ${#cloned} equals 0
}

@test 'A spec marked enabled=false is not loaded' {
    # spec/zsh-autocomplete.spec.zsh sets enabled=false, and its clone is
    # present in the borrowed plugin cache, so nothing but the flag stops it
    # loading. rc/plugin.rc.zsh reaches its `continue` from inside an anonymous
    # function, which is worth pinning rather than assuming.
    run sandbox_zsh_stdout "$SANDBOX" -i -c \
        'print -r -- $(( $+functions[autocomplete.async] ))'

    assert "$output" equals 0
}

@test 'Menu selection gets vi motions when fzf is absent' {
    # rc/completion.rc.zsh only binds these on the branch without fzf-tab.
    (($+commands[fzf])) && skip 'fzf is installed, so fzf-tab owns the menu'

    run sandbox_zsh_stdout "$SANDBOX" -i -c 'bindkey -M menuselect "^h"'

    assert "$output" contains vi-backward-char
}

@test 'Generated completions are on fpath' {
    run sandbox_zsh_stdout "$SANDBOX" -i -c \
        'print -r -- ${fpath[(Ie)$zsh_dirs[cache_comp]]}'

    assert "$output" is_greater_than 0
}

@test 'comp/ precedes the system completion directories' {
    # The herdr package installs its own _herdr in site-functions, and
    # comp/_herdr only shadows it from ahead of that directory, since both
    # compinit and autoload take the first file of a name found on fpath.
    #
    # The system directories are whatever zsh itself starts with, read from a
    # shell that loads no configuration, and handed in through the environment
    # since the sandbox passes nothing else through.
    local -a SANDBOX_ENV=(ZSH_TEST_DEFAULT_FPATH="$(zsh -fc 'print -r -- $FPATH')")

    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        local -i comp=${fpath[(Ie)$zsh_dirs[comp]]} at
        local dir
        print -r -- "comp:$comp"
        for dir in ${(s.:.)ZSH_TEST_DEFAULT_FPATH}; do
            at=${fpath[(Ie)$dir]}
            ((at && at < comp)) && print -r -- "ahead:$dir"
        done
    '

    local -a ahead=(${(M)lines:#ahead:*})

    assert "$lines[1]" different_to 'comp:0'
    assert "${(j: :)ahead}" is_empty
}

@test 'The chezmoi aliases name real subcommands' {
    local bin="$SANDBOX/stub-bin"
    mkdir -p -- "$bin"
    print -rl -- '#!/bin/sh' 'exit 0' > "$bin/chezmoi"
    chmod 0755 -- "$bin/chezmoi"

    local PATH="$bin:$PATH"

    run sandbox_zsh_stdout "$SANDBOX" -i -c 'print -r -- $aliases[czd]'

    assert "$output" same_as 'cz destroy'
}

@test 'The bat help pager leaves a human-readable -h alone' {
    local bin="$SANDBOX/stub-bin"
    mkdir -p -- "$bin"
    print -rl -- '#!/bin/sh' 'exit 0' > "$bin/bat"
    chmod 0755 -- "$bin/bat"

    local PATH="$bin:$PATH"

    # zle is shadowed by a no-op, so the widget can be driven outside the line
    # editor and its rewrite of BUFFER read back.
    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        function zle() { : }
        for BUFFER in "df -h" "sudo du -h" "git -h" "git --help"; do
            _zle_accept_line_help_bat
            print -r -- "$BUFFER"
        done
    '

    local -a lines=("${(@f)output}")

    assert "$lines[1]" same_as 'df -h'
    assert "$lines[2]" same_as 'sudo du -h'
    assert "$lines[3]" same_as 'git -h 2>&1 | bat --language=help'
    assert "$lines[4]" same_as 'git --help 2>&1 | bat --language=help'
}

@test 'Named directories that do not exist stay undefined' {
    # util/systemd.rc.zsh once redefined ~sysu and ~envd without checking for
    # the directories, overriding rc/directory.rc.zsh, which does check.
    local bin="$SANDBOX/stub-bin"
    mkdir -p -- "$bin"
    print -rl -- '#!/bin/sh' 'exit 0' > "$bin/systemctl"
    chmod 0755 -- "$bin/systemctl"

    local PATH="$bin:$PATH"

    run sandbox_zsh_stdout "$SANDBOX" -i -c \
        'print -r -- ${nameddirs[sysu]-unset} ${nameddirs[envd]-unset}'

    assert "$output" same_as 'unset unset'
}

@test 'Completion matches dotfiles by its own options' {
    run sandbox_zsh_stdout "$SANDBOX" -i -c \
        'print -r -- ${_comp_options[(Ie)globdots]}'

    assert "$output" is_greater_than 0
}

@test 'An interactive shell writes no byte to stdout' {
    local -i bytes
    bytes=$(sandbox_zsh_stdout "$SANDBOX" -i -c exit | wc -c)

    assert $bytes equals 0
}

@test 'Every function file is marked for autoload' {
    run sandbox_zsh_stdout "$SANDBOX" -i -c '
        local name
        for name in $zsh_dirs[func]/*(N.:t) $zsh_dirs[wrap]/*(N.:t); do
            (($+functions[$name])) || print -r -- "not autoloaded: $name"
        done
    '

    assert "$output" is_empty
}

@test 'Termux named directories hold clean paths' {
    local -a SANDBOX_ENV=(TERMUX_VERSION=0.118)

    run sandbox_zsh_stdout "$SANDBOX" -i -c \
        'print -r -- $nameddirs[emul] $nameddirs[edl]'

    assert "$output" same_as '/storage/emulated/0 /storage/emulated/0/Download'
}

@test 'The loaders leave no file list behind' {
    run sandbox_zsh_stdout "$SANDBOX" -i -c 'print -r -- $+zshenvs $+zshrcs'

    assert "$output" same_as '0 0'
}

@test 'Stray dotfiles beside the config are not loaded' {
    # .zshrc sets globdots, so a bare * in a loader also matched dotfiles: an
    # editor swap file in spec/ was sourced, and one in rc/ or util/ too.
    local conf
    conf="$(sandbox_copy_config "$SANDBOX" dotfile-probe)"

    print -r -- 'print -u2 PROBE-SPEC' > "$conf/spec/.probe.spec.zsh"
    print -r -- 'print -u2 PROBE-RC' > "$conf/rc/.probe.rc.zsh"
    print -r -- 'print -u2 PROBE-UTIL' > "$conf/util/.probe.rc.zsh"

    run sandbox_zsh "$SANDBOX" -c "ZDOTDIR=${(q)conf} zsh -i -c exit"

    assert "$output" does_not_contain 'PROBE-SPEC'
    assert "$output" does_not_contain 'PROBE-RC'
    assert "$output" does_not_contain 'PROBE-UTIL'
}

@test 'A stale completion dump is freshened by the next start' {
    # compinit leaves a still-valid dump untouched, so without a touch its age
    # kept growing and every start after the first day skipped compinit -C.
    run sandbox_zsh_stdout "$SANDBOX" -c '
        dump="$XDG_CACHE_HOME/zsh/zcompdump"
        [[ -f "$dump" ]] || exit 1
        touch -d "2 days ago" -- "$dump" || exit 1
        zsh -i -c exit
        local -a fresh=("$dump"(Nmh-1))
        print -r -- ${#fresh}
    '

    assert "$output" equals 1
}

@test 'An empty chezmoi completion cache is regenerated' {
    # The redirect that writes the cache truncates before chezmoi runs, so a
    # failed run left an empty file, and a -r test accepted it from then on.
    local bin="$SANDBOX/stub-bin"
    mkdir -p -- "$bin"
    print -rl -- '#!/bin/sh' 'echo "#compdef chezmoi"' > "$bin/chezmoi"
    chmod 0755 -- "$bin/chezmoi"
    touch -d '3 days ago' -- "$bin/chezmoi"

    local PATH="$bin:$PATH"

    run sandbox_zsh_stderr "$SANDBOX" -c '
        comp="$XDG_CACHE_HOME/zsh/completions/_chezmoi"
        : >| "$comp"
        zsh -i -c exit
    '

    assert "$output" contains 'Regenerating chezmoi completion file'
}

@test 'A runtime under a hostile directory name loads each module once' {
    # Spec criterion A3. Spaces and every loader keyword in one name. The
    # .zshrc reorder patterns are anchored to the final path component;
    # matched as bare substrings they would catch every file here and source
    # each more than once, and an unquoted expansion would split the path.
    local conf
    conf="$(sandbox_copy_config "$SANDBOX" 'a completion function ls_colors dir')"

    print -r -- 'print -u2 PROBE-RC' > "$conf/rc/probe.rc.zsh"
    print -r -- 'print -u2 PROBE-UTIL' > "$conf/util/probe.rc.zsh"

    # Appended after the defaults, so this ZDOTDIR wins.
    local -a SANDBOX_ENV=(ZDOTDIR="$conf")

    run sandbox_zsh "$SANDBOX" -i -c '
        print -r -- "rc:$zsh_dirs[rc]"
        print -r -- "empty:${#${(@M)fpath:#}}"
    '

    # Filtered through unquoted array assignments. Inside double quotes the
    # array is joined into one word before the :# filter runs, so a filter
    # anchored to the start of a line would never match.
    local -a rc_hits=(${(M)lines:#PROBE-RC})
    local -a util_hits=(${(M)lines:#PROBE-UTIL})
    local -a rc_line=(${(M)lines:#rc:*})
    local -a empty_line=(${(M)lines:#empty:*})

    assert ${#rc_hits} equals 1
    assert ${#util_hits} equals 1
    assert "$rc_line" same_as "rc:$conf/rc"
    assert "$empty_line" same_as 'empty:0'
}

@test 'An installed copy of the tracked runtime starts on its own' {
    # Spec criterion A4, and the startup half of A9. Shaped like the live
    # installation: tracked files only, copied rather than linked, reached
    # through the configuration path. Repository-local tool directories are
    # dropped from PATH, so a startup that quietly needed Bun or the test
    # binaries would show here. Every probe line has to name the copy, so a
    # shell that started cleanly but loaded nothing cannot pass.
    local root live
    root="$(sandbox_create)"
    live="$(sandbox_install_runtime "$root")"

    # Filtered in an unquoted assignment first: inside double quotes $path
    # would be joined into one word before the filter saw an element.
    local -a tool_path=(${path:#$ZSH_REPO_ROOT/*})
    local PATH="${(j.:.)tool_path}"
    local -a SANDBOX_ENV=(ZSH_TEST_REPO_ROOT="$ZSH_REPO_ROOT")

    sandbox_warm "$root"

    local diagnostics probe
    diagnostics="$(sandbox_zsh_stderr "$root" -i -c exit)"
    probe="$(sandbox_zsh_stdout "$root" -i -c '
        autoload +X mkcd
        print -r -- "conf:${zsh_dirs[conf]:A}"
        print -r -- "func:${functions_source[mkcd]:A}"
        print -r -- "complete:$+functions[_main_complete]"
        print -r -- "plugins:${#zsh_plugins_loaded}"
        local entry
        for entry in $fpath ${(v)zsh_dirs}; do
            [[ "${entry:A}/" == "$ZSH_TEST_REPO_ROOT"/* ]] &&
                print -r -- "leak:$entry"
        done
        true
    ')"

    local -a links=("$live"/**/*(N@D))
    local -a generated=("$live"/zsh/env/chezmoi.env.zsh(N))
    local expected="${live:A}"

    sandbox_destroy "$root"

    local -a lines=("${(@f)probe}")
    local -a leaks=(${(M)lines:#leak:*})

    assert "$diagnostics" is_empty
    assert "$lines[1]" same_as "conf:$expected/zsh"
    assert "$lines[2]" same_as "func:$expected/zsh/func/mkcd"
    assert "$lines[3]" same_as 'complete:1'
    assert "$lines[4]" different_to 'plugins:0'
    assert "${(j: :)leaks}" is_empty
    assert ${#links} equals 0
    assert ${#generated} equals 0
}

@test 'A home startup link starts the interactive runtime' {
    # The interactive half of spec criterion A6; see the note on the same
    # test in env.zunit. .zshrc is found through the ZDOTDIR that
    # env/zsh_dirs.env.zsh assigns, not one inherited from anywhere.
    sandbox_global_sets_zdotdir "$SANDBOX" &&
        skip 'The global zshenv assigns ZDOTDIR, so ~/.zshenv is never read'

    local root
    root="$(sandbox_create)"
    sandbox_install_runtime "$root" > /dev/null
    ln -s -- "$root/.config/zsh/.zshenv" "$root/.zshenv"

    sandbox_zsh_home "$root" -i -c exit > /dev/null 2>&1

    local probe
    probe="$(sandbox_zsh_home "$root" -i -c '
        print -r -- "rc:$zsh_dirs[rc]"
        print -r -- "complete:$+functions[_main_complete]"
        print -r -- "plugins:${#zsh_plugins_loaded}"
    ' 2> /dev/null)"

    sandbox_destroy "$root"

    local -a lines=("${(@f)probe}")

    assert "$lines[1]" same_as "rc:$root/.config/zsh/rc"
    assert "$lines[2]" same_as 'complete:1'
    assert "$lines[3]" different_to 'plugins:0'
}
