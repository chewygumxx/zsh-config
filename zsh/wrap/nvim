#
# Zsh wrapper function for Neovim.
#

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

if ((!$+commands[nvim])); then
    print -u2 "${__this_file}: Command not found: nvim"
    return 127
fi
# Anything other than exactly one operand goes straight through. A lone option
# counts as no operand at all: resolved with ${1:a} below, `nvim --version`
# opened a new file called $PWD/--version, and `cmd | nvim -` opened one called
# $PWD/- rather than reading stdin. Every editor alias in rc/alias.rc.zsh
# inherited both.
if (($# != 1)) || [[ "$1" == [-+]* ]]; then
    command nvim "$@"
    return
fi

local target="${1:a}"

# ------------------
# Directories, Root
# ------------------

if [[ -d "$target" ]]; then
    cd "$target"
    return
fi

# zstat is a builtin of the zsh/stat module, which is not loaded by default.
# Without this the test raised `command not found: zstat` plus a `bad math
# expression` on every edit of an existing file, and the redirect to sudoedit
# below could never trigger. -F b:zstat loads that one builtin only, so the
# module's own `stat` builtin cannot shadow /usr/bin/stat for the session.
zmodload -F zsh/stat b:zstat

# zstat follows symlinks, so a link to a root-owned file lands here too.
# sudoedit refuses to open a path through a symlink unless sudoers sets
# sudoedit_follow, so it is handed the resolved path instead.
#
# The -e guard is needed because a new file reaches this test too. On a missing
# path zstat prints an error and the test becomes `(( == 0 ))`.
if [[ -e "$target" ]] && (($(zstat +uid "$target") == 0)); then
    SUDO_EDITOR=nvim command sudoedit "${target:A}"
    return
fi

# ----------------------
# chezmoi Managed Paths
# ----------------------

# `chezmoi managed <path>` builds the entire source state before it filters by
# path: it reads every file under the source directory and renders every
# template, password manager and command output lookups included. Asking about
# one file therefore costs as much as listing all of them, and asked here, that
# cost landed ahead of Neovim on every edit of an existing file. Its sibling
# `chezmoi source-path` is no cheaper, and the new file branch below once paid
# that after Neovim exited, about six seconds before the prompt came back.
#
# The full list is cached instead, and the lookup is a read of that file. The
# cache is never rebuilt in the foreground. When anything under the source
# directory, or the chezmoi config, is newer than it, the stale list answers
# this launch and a rebuild runs in the background for the next one. A file
# that became managed since the last rebuild is missed once, which only costs
# the re-add below for that one edit.
#
# The source directory is recorded next to the cache by each rebuild, because
# `chezmoi source-path` is itself a chezmoi process and asking it here would
# reintroduce the wait. The default location stands in until a rebuild has
# recorded the real one.
local -a managed=() managed_paths=()
local -a chezmoi_background=()

if (($+commands[chezmoi])); then
    local cache_root="${XDG_CACHE_HOME:=$HOME/.cache}/zsh"
    local cache_dir="${zsh_dirs[cache]:-$cache_root}/nvim"
    local cache="$cache_dir/chezmoi-managed"
    local source_dir="${XDG_DATA_HOME:=$HOME/.local/share}/chezmoi"

    # Disowning a job and redirecting stdin leave its controlling terminal
    # intact. A template or password helper can still open /dev/tty and stop
    # the whole background job with SIGTTIN while chezmoi holds its state lock.
    # Start a new session, bound the command and its children, and serialize
    # this wrapper's commands so a refresh cannot race an add or re-add.
    # Start the execution timeout after acquiring the serialization lock, so
    # queued edits retain their full execution budget.
    if (($+commands[setsid] && $+commands[timeout] && $+commands[flock])); then
        if command mkdir -p -- "$cache_dir"; then
            chezmoi_background=(
                flock --close "$cache_dir/chezmoi.lock"
                setsid --fork --wait
                timeout --verbose --kill-after=5s "${NVIM_CHEZMOI_TIMEOUT:-60s}"
                sh -c '
                    trap "while :; do sleep 1; done" TERM
                    "$@" &
                    wait "$!"
                    code=$?
                    if [ "$code" -ne 0 ]; then
                        printf "chezmoi background command exited with status %s\n" "$code" >&2
                    fi
                    exit "$code"
                ' nvim-chezmoi
                chezmoi
            )
        fi
    else
        print -u2 -- "$__this_file: Automatic chezmoi jobs require setsid, timeout and flock"
    fi

    # flock stays outside the timeout's process group and closes its lock
    # descriptor in children, so helpers cannot retain the queue lock.
    # The shell supervisor above stays alive after timeout sends SIGTERM,
    # ensuring its later SIGKILL reaches the entire process group even if
    # chezmoi exits first and leaves a helper holding an inherited lock.

    if [[ -s "$cache.source" ]]; then
        source_dir="$(< "$cache.source")"
    fi

    # .git is pruned because commits and fetches change it without changing
    # what chezmoi manages. The directories themselves are still compared, so
    # a deleted source file shows up through its parent's mtime. -H follows the
    # source directory itself when it is a symlink into a checkout elsewhere.
    local stale
    if [[ -e "$cache" ]]; then
        stale="$(command find -H "$source_dir" \
            "${XDG_CONFIG_HOME:=$HOME/.config}"/chezmoi/chezmoi.*(N) \
            -path "$source_dir/.git" -prune \
            -o -newer "$cache" -print -quit 2> /dev/null)"
    else
        stale=1
    fi

    if [[ -n "$stale" ]] && (($#chezmoi_background)); then
        # Only one refresh may run while the cache is stale. flock holds the
        # open description shared with this subshell until the refresh exits.
        # Both lists are published only after successful commands, preserving
        # the previous cache on failure. Diagnostics remain in chezmoi.log.
        #
        # The new cache takes the mtime of a stamp made before chezmoi started,
        # so a source edit made while the rebuild ran still reads as newer.
        {
            command flock -n 9 || return 0
            local stamp tmp tmp_source

            stamp="$(command mktemp -- "$cache.XXXXXXXX")" &&
                tmp="$(command mktemp -- "$cache.XXXXXXXX")" &&
                tmp_source="$(command mktemp -- "$cache.XXXXXXXX")" &&
                command "${chezmoi_background[@]}" managed --path-style absolute 9>&- >| "$tmp" &&
                command "${chezmoi_background[@]}" source-path 9>&- >| "$tmp_source" &&
                command touch -r "$stamp" -- "$tmp" &&
                command mv -f -- "$tmp_source" "$cache.source" &&
                command mv -f -- "$tmp" "$cache"

            command rm -f -- \
                ${stamp:+"$stamp"} ${tmp:+"$tmp"} ${tmp_source:+"$tmp_source"}
        } 9> "$cache.refresh.lock" < /dev/null > /dev/null 2>> "$cache_dir/chezmoi.log" &!
    fi

    # Both the path as given and the one it resolves to are looked up. ${1:a}
    # above only tidies the path and leaves symlinks alone, so a link to a
    # managed file, or a file reached through a linked directory, never
    # matched the list on its own. The given path is still kept: chezmoi can
    # manage the link itself, and Neovim is still opened on the path as typed.
    # Every match is re-added below, since editing through a managed link
    # writes to its target, which may be managed in its own right.
    if [[ -s "$cache" ]]; then
        managed_paths=("${(@f)$(<"$cache")}")
        local candidate

        for candidate in "$target" "${target:A}"; do
            if ((${managed_paths[(Ie)$candidate]} && !${managed[(Ie)$candidate]})); then
                managed+=("$candidate")
            fi
        done
    fi
fi

# ---------
# New File
# ---------

# A new file is offered to chezmoi when its directory is managed. That is
# answered from the cached list, which names directories as well as files, so
# no chezmoi process runs before the question. The add itself runs detached,
# since it builds the whole source state just as `chezmoi managed` does. A
# directory that became managed since the last rebuild is missed once.
#
# The question is asked here rather than through `chezmoi add --prompt`, which
# could only ask once that source state was built. Alone, read -q opens the
# terminal itself and fails when there is none; -u 0 reads stdin instead, still
# one keypress at a time on a terminal, and end of file declines. The question
# is printed rather than passed as read's ?prompt, which only an interactive
# shell displays, and the newline read -q never echoes follows it on stderr.
# The add uses the same session isolation and time limit as the cache refresh.
if [[ ! -e "$target" ]]; then
    command nvim "$target"
    local nvim_exit=$?

    if [[ ! -e "$target" ]]; then
        return $nvim_exit
    fi

    (($#chezmoi_background)) || return $nvim_exit

    local parent
    for parent in "${target:h}" "${target:h:A}"; do
        ((${managed_paths[(Ie)$parent]})) || continue

        local answer=1
        print -nu2 -- "Add ${(D)target} to chezmoi? [y/N] "
        read -q -u 0 && answer=0
        print -u2

        if ((answer == 0)); then
            command "${chezmoi_background[@]}" add -- "$target" \
                < /dev/null >> "$cache_dir/chezmoi.log" 2>&1 &!
        fi
        break
    done

    return $nvim_exit
fi

if (($#managed)); then
    local -x TMPDIR="${XDG_CACHE_HOME:=$HOME/.cache}/chezmoi"
    [[ ! -d "$TMPDIR" ]] && command mkdir -p "$TMPDIR"
    command nvim "$target"
    if (($#chezmoi_background)); then
        command "${chezmoi_background[@]}" re-add "${managed[@]}" \
            < /dev/null >> "$cache_dir/chezmoi.log" 2>&1 &!
    fi
    return
fi

command nvim "$@"
