#!/bin/false
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/zsh-config.git
# ::: :/func/countdown
#
#

emulate -L zsh
zmodload -F zsh/datetime p:EPOCHSECONDS

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

# ---------
# Validate
# ---------

(($# == 1)) || {
    print -u2 -f 'usage: %s SECONDS' "$__this_file"
    return 2
}

[[ $1 == <-> ]] || {
    print -u2 -f '%s: SECONDS must be a non-negative integer' "$__this_file"
    return 2
}

# --------
# Execute
# --------

local -i current finish
current=$EPOCHSECONDS
finish=$((current + $1))

trap 'print -n "\e[?25h"; print' EXIT # Render Cursor
print -n '\e[?25l'                    # Hide Cursor

while ((finish > current)); do
    current=$EPOCHSECONDS
    print -n -f '\r\e[2KSecs remaining: %d' \
        "$((finish - current))"
    sleep 1
done

return $?
