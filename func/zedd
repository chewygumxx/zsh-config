#
# Edit Zsh function file in Neovim
#

local __this_file="${(D)${${(%):-%N}:a}}"

local func_name="$1"

if [[ -z "$func_name" ]]; then
    print -u2 "${__this_file}: Usage: zed <function-name>"
    return 1
fi

local func_file fpath_dir
for fpath_dir in $fpath; do
    if [[ -f "$fpath_dir/$func_name" ]]; then
        func_file="$fpath_dir/$func_name"
        break
    fi
done

if [[ -z "$func_file" ]]; then
    print -u2 "${__this_file}: No function file found in \$fpath for: $func_name"
    return 127
fi

nvim "$func_file"

unset -f "$func_name"
autoload -Uz "$func_file"

