local PASS_URI_OPENROUTER_APIKEY="${PASS_URI_OPENROUTER_APIKEY:-"pass://J-xaaVbsyf9NXSOTldrv8KqCo46GwqzhNFBtLlq80kZIVU6i54tu3l1k2-poPAfD-O6sOeYHLPzPIaCj8v20pg==/NbssAEYTKTxgsBgkYlmtOQJ9rccg8Vm93YDxF9BC4neMF06etWFU35EtsLES93nSSExPI5MnFSC5LhwjMylB1A==/API\ Key"}"

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

# `log` is an unusually collision-prone name to leave defined in an interactive
# shell, and zsh defines functions globally, so without this it persisted after
# the first call and shadowed anything else named log. An EXIT trap set inside a
# function runs when that function returns.
trap 'unset -f log' EXIT

function log () {
    if [[ "$2" == "--" ]]; then
        local ctx="$1"; shift 2
    fi

    case "$1" in
        FATAL|INFO|NOTICE|WARN|ERROR)
            local level="$1"; shift
            local message="$*"
            ;;
        *)
            print -u2 -f "%s: [%s] %s\n" "$__this_file" FATAL \
                "${ctx:+"($ctx) "}Invalid log call: Level provided not INFO, NOTICE, WARN, ERROR or FATAL: $@"
            print -u2 -f "%s: [%s] %s\n" "$__this_file" FATAL \
                "'log ${ctx:+"($ctx) -- "}$@"
            return 1
            ;;
    esac

    # \n included. Without it consecutive messages ran together on one line.
    print -u2 -f "%s: [%s] %s\n" "$__this_file" "$level" "${ctx:+"($ctx) "}$message"
}

local command_not_found=0
if ! (( $+commands[pass-cli] )); then
    log FATAL "Command not found: pass-cli"
    command_not_found=1
fi

if ! (( $+commands[curl] )); then
    log FATAL "Command not found: curl"
    command_not_found=1
fi

(( command_not_found )) && return 127

if [[ "$PASS_URI_OPENROUTER_APIKEY" != "pass://"* ]]; then
    log FATAL "Variable PASS_URI_OPENROUTER_APIKEY is not of pass:// URI Format"
    return 1
fi

# Assigned apart from the declaration. `local x="$(...)"` reports the status of
# local itself, so a failed lookup went unnoticed and the request was sent with
# an empty bearer token.
local OPENROUTER_APIKEY
if ! OPENROUTER_APIKEY="$(pass-cli item show "$PASS_URI_OPENROUTER_APIKEY")" ||
    [[ -z "$OPENROUTER_APIKEY" ]]; then
    log FATAL "Unable to read the API key from: $PASS_URI_OPENROUTER_APIKEY"
    return 1
fi

# The header is handed to curl through a file descriptor, never as an
# argument. Arguments are readable by every local user through
# /proc/<pid>/cmdline for as long as curl runs, and `-H "Authorization: ..."`
# put the key there. `-H @file` reads headers from a file (curl 7.55 and
# later), and process substitution gives it a /proc/self/fd path instead.
\builtin command curl --fail-with-body --silent --show-error \
    'https://openrouter.ai/api/v1/chat/completions' \
    -H 'Content-Type: application/json' \
    -H @<(print -r -- "Authorization: Bearer $OPENROUTER_APIKEY") \
    --data-raw "$1"
