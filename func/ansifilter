#
# Filters ANSI escape codes from stdin and prints to stdout
#

# functions_source, not %N:A. In an autoloaded function %N is the bare
# function name, so :A resolved it against $PWD rather than fpath.
local __this_file="${(D)${functions_source[${(%):-%N}]:-${(%):-%N}}}"

if [[ ! -t 0 ]]; then
    sed "s,\x1B\[[0-9;]*[a-zA-Z],,g" </dev/stdin
    return 0
else
    print -u2 -f "%s: [%s] %s\n" "${__this_file}" FATAL "Intended for read piped data from stdin"
    return 1
fi
