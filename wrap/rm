#
#
# ~chewygumxx/zsh-config.git
# ::: :/wrap/rm
#
#

local n=$'\e[0m'      # None
local grn=$'\e[0;32m' # Green
local ylw=$'\e[0;33m' # Yellow
local blu=$'\e[0;34m' # Blue
local MAG=$'\e[1;35m' # Magenta Bold

# Refusing is reported on stderr and as a failure. It used to print to stdout
# and return 0, so `rm file && next` carried on as though the file were gone,
# as did any function in the interactive shell that calls a bare rm.
if (( $+commands[gtrash] )) && (( $+aliases[del] )); then
    printf "%s\n" >&2 "${grn}gtrash ${n}is installed, try the ${blu}alias ${grn}del${ylw}='${blu}gtrash ${MAG}put${ylw}'"
    #print -z "del $@"  # Gentle nudge
    return 1
fi

if (( $+commands[trash-put] )) && (( $+aliases[del] )); then
    printf "%s\n" >&2 "${grn}trash-cli ${n}is installed, try the ${blu}alias ${grn}del${ylw}='${blu}trash-put${ylw}'"
    #print -z "del $@"  # Gentle nudge
    return 1
fi

command rm "$@"
