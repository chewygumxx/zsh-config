#

#
# pacman, by way of yay whenever yay is installed
#
# A function rather than the alias this used to be. rc/alias.rc.zsh also defines
# `alias sudo="sudo "`, whose trailing space alias-expands the word after it, so
# `sudo pacman -Syu` became `sudo yay -Syu`, which yay refuses to run as root.
# Functions are never expanded after sudo, so sudo reaches the real pacman.
#

if (( $+commands[yay] )); then
    command yay "$@"
else
    command pacman "$@"
fi
