#!/bin/false
# vim: expandtab:shiftwidth=4

#
#
# ~chewygumxx/dotfiles.git
# ::: :/home/dot_config/zsh/wrap/chezmoi
#
#

#
# Zsh function wrapper for command line shell utility: chezmoi
#

emulate -L zsh
setopt local_options re_match_pcre

local __this__file="${(D)${${(%):-%N}:A}}"

if (( ! $+commands[chezmoi] )); then
    print -u2 -f "%s: [%s] %s" "${__this_file}" FATAL "Command not found: chezmoi"
    return 127
fi


# -----
# Help
# -----

help_pager () {
    if (( $+commands[bat] )); then
        printf '%s\n' "bat --language=help"
    else
        printf '%s\n' "less --raw-control-characters --quit-if-one-screen"
    fi
}

help_main() {
    local cgxx_cmds=(
        "alias"     "[cgxx] Alias management"
    )
    local cgxx_help_sect="$(printf '%s\n%s' "Commands of chewygumxx:" "$(printf '  %-20s %s\n' $cmds)")"

    local chez_help_raw="$(command chezmoi help)"
    local chez_help_sects=( "${(@ps:\n\n:)chez_help_raw}" )

    local -a help_output=(
        ${chez_help_sects[1,3]}
        ${cgxx_help_sect}
        ${chez_help_sects[3,-1]}
    )
    printf '%s\n\n' $help_output | $(help_pager)
}

# ------
# Alias
# ------

alias_help () {
    # TODO(@chewygumxx): [Low]
    IFS=' ' printf '%s\n' "$*"
}

alias_main () {
    if [[ "$1" == "help" ]]; then
        shift
        alias_help "$@"
        return
    fi

    # TODO(@chewygumxx): [Low]
    IFS=' ' printf '%s\n' "$*"
}


# ---------------
# Argument Parse
# ---------------

dispatch () {
    if [[ "$1" =~ "(help|--help)" ]]; then
        local help_first_arg=1
        shift
    fi

    # No argument or just help/--help
    if (( $# == 0 )); then
        print_help_main
        return
    fi

    case "$1" in
        alias)
            shift
            alias_management ${help_first_arg:+"help"} "$@"
            ;;
        *)
            # Handle natively
            command chezmoi  ${help_first_arg:+"help"} "$@"
            ;;
    esac
}

dispatch "$@"
