if (( $# == 0 )) && (( $+commands[systemctl-tui] )); then
    command systemctl-tui --scope user
    return
fi

if (( $# == 1 )) && [[ "$1" == "--user" ]] && (( $+commands[systemctl-tui] )); then
    command systemctl-tui --scope user
    return
fi

command systemctl "$@"

