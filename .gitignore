# vim:set expandtab shiftwidth=4 filetype=gitignore:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/zsh-config.git
# ::: :/.gitignore
#
#

.env*
*.local.*

node_modules/
/.herdr/
/.claude/worktrees/
/.templates/

/.remember/
/.superpowers/
*claude.json

# Test runner binaries fetched by the test:deps task
.bin/

# zunit writes its text and HTML result logs here
tests/_output/

# revolver, zunit's progress spinner, defaults its state directory to
# ${ZDOTDIR:-$HOME}/.revolver. ZDOTDIR is a checkout of this repository, so this
# is ignored as a safety net alongside the REVOLVER_DIR override in .mise.toml.
.revolver/
