#compdef herdr
# vim:set expandtab shiftwidth=4 filetype=zsh:
# SPDX-License-Identifier: GPL-3.0-only
#
#
# ~chewygumxx/zsh-config.git
# ::: :/comp/_herdr
#
#
#
# Loader for the completion function herdr generates for itself, amended so
# that pane, tab, workspace and agent arguments complete from the live server.
#
# `herdr completion zsh` is generated by clap, and every one of those arguments
# falls back to _default, which offers filenames. On first use this writes that
# script to $zsh_dirs[cache_comp]/herdr.zsh with each such action replaced by
# _herdr_live_ids, sources it over this stub and hands the call on to the real
# _herdr. Amending the generated script rather than writing one by hand keeps
# every subcommand and option in step with whichever herdr is installed.
#
# The amendment is matched on the argument names alone, which the installed
# herdr is free to change. tests/comp.zunit runs it against the real script
# for that reason, so a rename fails there instead of quietly falling back to
# filenames.
#
# Shadows the _herdr the herdr package installs in site-functions, which is
# that same script unamended. That only works because rc/completion.rc.zsh puts
# comp/ ahead of the system directories on fpath.
#
# The cache is named without a leading underscore so that compinit, which
# indexes only `_*` files, never registers it in competition with this stub.
#

# functions_source is a zsh/parameter special, assigned by zsh itself, which
# shuck cannot see.
# shuck: disable=C006
local self="$functions_source[_herdr]"

zsh_dirs_require "${(D)self:-$0}" cache_comp || return 1

#
# Offer the live workspaces, tabs, panes or agents named by the last argument.
#
# The last rather than the first, because _arguments calls an action given as
# a command and words with its own compadd options, such as `-J argument-1`,
# inserted ahead of the words. Those options are not passed on: _describe
# supplies a group and a heading of its own, and `-X` would replace the
# heading with the bare argument name.
#
# --session is read back out of the command line being completed, since the
# generated _herdr has consumed it long before any id is completed. A command
# aimed at another machine offers nothing: its ids live on a server the local
# snapshot knows nothing of, and asking that one would mean ssh on every Tab.
#
# herdr's stderr is discarded here and nowhere else, because anything printed
# during completion lands in the middle of the line being edited. The status is
# kept, so a stopped server still reads as a failure.
#
function _herdr_live_ids() {
    local kind="${@[-1]}"
    local -a words_typed=(${(z)BUFFER}) options=() candidates=()

    if ((${words_typed[(I)--(machine|remote)(|=*)]})); then
        return 1
    fi

    local -i at=${words_typed[(I)--session]}
    local joined=${words_typed[(r)--session=*]}

    if ((at)) && [[ -n "$words_typed[at + 1]" ]]; then
        options=(--session "${(Q)words_typed[at+1]}")
    elif [[ -n "$joined" ]]; then
        options=(--session "${(Q)joined#--session=}")
    fi

    local line
    for line in "${(@f)$(__herdr_ids "$kind" $options 2>/dev/null)}"; do
        [[ -n "$line" ]] || continue
        candidates+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
    done

    (($#candidates)) || return 1

    _describe -t "$kind" "herdr ${kind%s}" candidates
}

local comp_file="$zsh_dirs[cache_comp]/herdr.zsh"

# Regenerate the cache if either:
#  - Missing or empty
#  - Older than the herdr binary
#  - Older than this file
#
# Written to a staging file and moved into place only once non-empty, so a
# failed run cannot leave behind a cache that the next completion would source.
if (($+commands[herdr])) && {
    [[ ! -s "$comp_file" ]] ||
        [[ "$comp_file" -ot "$commands[herdr]" ]] ||
        [[ "$comp_file" -ot "$self" ]]
}; then
    local staging="$comp_file.$$" generated

    if generated="$(command herdr completion zsh)" && [[ -n "$generated" ]]; then

        () {
            # The rewrite needs extended_glob, which this stub cannot assume of
            # the shell completing, so it runs in a scope of its own.
            #
            # Each `curcontext=...-command-...` line opens a subcommand's case
            # block, so the most recent one says whether a `target` belongs to
            # `herdr agent`, where it is an agent, or elsewhere, such as under
            # `herdr terminal session`, where it is a terminal.
            #
            # The foot of the script is clap's dispatch, which calls compdef
            # when the file is sourced rather than autoloaded, as it is here.
            # It is dropped, since this stub calls _herdr itself.
            emulate -L zsh
            setopt extended_glob

            # Each kind's argument specs, as everything between a spec's opening
            # quote and its `:_default`. Kept as strings and matched through
            # ${~...} rather than written out as case patterns, because
            # shuck format rewrites a case pattern's (a|b) as the ksh @(a|b),
            # which zsh reads as a literal @ unless ksh_glob is set.
            local -A specs=(
                panes '(|:):pane_id|--(|source-|target-)pane\[*\]:(ID|PANE)'
                tabs '(|:):tab_id|--tab\[*\]:(ID|TAB_ID)'
                workspaces '(|:):workspace_id|--workspace\[*\]:(ID|WORKSPACE_ID)'
                agents '(|:):target'
            )

            # Held in a variable because a quote escaped as \' in the replacement
            # half of ${line/.../...} is written out with its backslash.
            local q="'"
            local line kind pattern
            local -i in_agent=0
            local -a amended=()

            # The single-quoted text below is herdr's generated code, matched
            # as it is written, so the expansions in it are meant to stay
            # literal and the C005 warnings about that are suppressed.
            for line in "${(@f)generated}"; do
                # shuck: disable=C005
                [[ "$line" == 'if [ "$funcstack[1]" = "_herdr" ]; then' ]] && break

                # shuck: disable=C005
                if [[ "$line" == *'curcontext="${curcontext%:*:*}:herdr-'*'-command-$line[1]:"'* ]]; then
                    # shuck: disable=C005
                    if [[ "$line" == *':herdr-agent-command-$line[1]:"'* ]]; then
                        in_agent=1
                    else
                        in_agent=0
                    fi
                fi

                for kind in ${(k)specs}; do
                    pattern="[[:space:]]#$q(${specs[$kind]}):_default$q*"
                    [[ "$line" == ${~pattern} ]] || continue
                    [[ "$kind" != agents ]] || ((in_agent)) || continue

                    line="${line/:_default$q/:_herdr_live_ids $kind$q}"
                    break
                done

                amended+=("$line")
            done

            # Quoted, unlike most array expansions here, so that the blank lines
            # between the generated functions are kept.
            print -rl -- "${amended[@]}" >| "$staging"
        }
    fi

    if [[ -s "$staging" ]]; then
        command mv -f -- "$staging" "$comp_file"
    else
        command rm -f -- "$staging"
    fi
fi

[[ -s "$comp_file" ]] || return 1

source "$comp_file"

# Without this, a cache that somehow lacks a _herdr definition would leave this
# stub as _herdr, and the call below would recurse into itself without end.
[[ "$functions_source[_herdr]" != "$self" ]] || return 1

_herdr "$@"
